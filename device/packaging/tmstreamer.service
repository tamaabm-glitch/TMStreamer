[Unit]
Description=TMStreamer standalone service
After=NetworkManager.service systemd-modules-load.service
Wants=NetworkManager.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/tmstreamer run
# Re-reads the login, after `tmstreamer password`
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# systemd creates the TMStreamer configuration and state directories.
ConfigurationDirectory=tmstreamer
StateDirectory=tmstreamer
# Finishing an open recording can take a few seconds
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
