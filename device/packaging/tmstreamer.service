[Unit]
Description=TMStreamer standalone service
After=NetworkManager.service systemd-modules-load.service
Wants=NetworkManager.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/ystreamer run
# Re-reads the login, after `ystreamer password`
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# Keep the upstream-compatible settings and recordings locations.
ConfigurationDirectory=tmstreamer
StateDirectory=tmstreamer
# Finishing an open recording can take a few seconds
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
